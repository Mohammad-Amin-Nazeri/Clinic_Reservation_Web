@model Clinic.Application.DTOs.Paging.BasePaging

<div class="row justify-content-center">
    <div>
        <span>@Model.GetCurrentPagingStatus()</span>
    </div>
    <div class="mt-2">
        <nav aria-label="Page navigation" class="pagination-nav">
            <ul class="pagination">
                @if (Model.StartPage < Model.PageId)
                {
                    <li class="page-item">
                        <a onclick="SubmitPageId(@(Model.PageId - 1))" aria-label="Previous" class="page-link" href="javascript:void(0)" tabindex="-1">
                            <span aria-hidden="true">
                                <i class="fa fa-angle-double-right"></i>
                            </span>
                            <span class="visually-hidden">قبلی</span>
                        </a>
                    </li>
                }

                @for (var i = Model.StartPage; i <= Model.EndPage; i++)
                {
                    <li class="page-item @(Model.PageId == i ? "active" : "")">
                        <a onclick="SubmitPageId(@i)" class="page-link" href="javascript:void(0)">@i</a>
                    </li>
                }

                @if (Model.EndPage > Model.PageId)
                {
                    <li class="page-item">
                        <a onclick="SubmitPageId(@(Model.PageId + 1))" aria-label="Next" class="page-link" href="javascript:void(0)">
                            <span aria-hidden="true">
                                <i class="fa fa-angle-double-left"></i>
                            </span>
                            <span class="visually-hidden">بعد</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
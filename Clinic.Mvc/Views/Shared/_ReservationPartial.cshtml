@model List<Clinic.Data.Entities.Reservation>

<table class="table table-bordered table-vcenter">
    <thead>
        <tr>
            <th class="text-center" style="width: 50px;">#</th>
            <th>تاریخ</th>
            <th>وضعیت</th>
            <th class="text-center">عملیات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var index = 1;
            @foreach (var item in Model)
            {
                <tr>
                    <th class="text-center" scope="row">@index</th>
                    <td class="fw-semibold">
                        <span>@item.ReserveDate.ToLongDateString()</span>
                    </td>
                    <td class="d-none d-sm-table-cell">
                        @if (item.Reserved)
                        {
                            <span class="badge bg-danger">رزرو شده</span>
                        }
                        else
                        {
                            <span class="badge bg-success">رزرو نشده</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group">
                            <a class="btn btn-sm btn-primary">
                                <i class="fa fa-plus"></i> ثبت نوبت
                            </a>
                        </div>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <div class="alert alert-info d-flex align-items-center" role="alert">
                <div class="flex-shrink-0">
                    <i class="fa fa-fw fa-info-circle"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <p class="mb-0">نوبتی برای این تاریخ یافت نشد.</p>
                    <a href="#" class="btn btn-outline-success btn-sm">ایجاد نوبت برای این تاریخ</a>
                </div>
            </div>
        }
    </tbody>
</table>
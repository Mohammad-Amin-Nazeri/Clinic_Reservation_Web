@using Clinic.Application.DTOs.ReserveRecords
@using Clinic.Application.Utilities
@model Clinic.Application.DTOs.ReserveRecords.FilterRecordsDto
@{
    ViewData["Title"] = "لیست نوبت ها";
    var index = 1;
}

<div class="content">
    <form asp-controller="Record" asp-action="FilterRecord" method="get" id="DataForm">
        <input type="hidden" asp-for="PageId" id="PageId" />
        <div class="block block-rounded">
            <div class="block-header block-header-default">
                <h3 class="block-title">@ViewData["Title"]</h3>
                <div class="block-options">
                    <div class="block-options-item">
                        <a data-bs-target="#modal-default-normal" data-bs-toggle="modal"
                           class="btn btn-primary btn-sm">جستجوی نوبت</a>
                    </div>
                </div>
            </div>

            <div class="block-content">
                @if (Model.Data.Any())
                {
                    <table class="table table-vcenter table-bordered">
                        <thead>
                            <tr class="table-dark">
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>نام و نام خانوادگی</th>
                                <th>تاریخ نوبت</th>
                                <th>ساعت نوبت</th>
                                <th>شماره تماس</th>
                                <th class="d-none d-sm-table-cell" style="width: 15%;">تاریخ ثبت</th>
                                <th class="text-center" style="width: 150px;">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.Data)
                            {
                                <tr>
                                    <th class="text-center" scope="row">@index )</th>
                                    <td class="fw-semibold">
                                        <a asp-controller="Record" asp-action="RecordDetail" asp-route-id="@record.Id">@record.Patient.FullName</a>
                                    </td>
                                    <td class="">
                                        <span class="">@record.Reservation.ReserveDate.ToShortDateString()</span>
                                    </td>
                                    <td>
                                        <span class="">@record.Reservation.ReserveDate.ToString("HH:mm")</span>
                                    </td>
                                    <td>
                                        <span class="">@record.Patient.Mobile</span>
                                    </td>
                                    <td>
                                        <span>@record.CreateDate.ToShamsiDate()</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="Record" asp-action="EditRecord" asp-route-id="@record.Id" class="btn btn-sm btn-warning">
                                                ویرایش
                                            </a>
                                            <a data-bs-target="#modal-default-normal-@record.Id" data-bs-toggle="modal"
                                               class="btn btn-sm btn-danger">
                                                حذف
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>

                    <partial name="_Pagination" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0">اطلاعاتی با توجه به نتیجه ی جستجو یافت نشد.</p>
                    </div>
                }
            </div>
        </div>

        <!-- جستجوی بیمار -->
        <div aria-hidden="true" aria-labelledby="modal-default-normal" class="modal" id="modal-default-normal" role="dialog" tabindex="-1">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="block-header bg-primary-dark text-light">
                        <h3 class="block-title">جستجوی نوبت ها</h3>
                        <div class="block-options">
                            <button aria-label="Close" class="btn-block-option" data-bs-dismiss="modal" type="button">
                                <i class="fa fa-fw fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div class="modal-body pb-1">
                        <div class="row">
                            <div class="col-12 col-md-6 mb-2">
                                <label class="form-label">نام و نام خانوادگی</label>
                                <input class="form-control" asp-for="PatientName">
                            </div>

                            <div class="col-12 col-md-6 mb-2">
                                <label class="form-label">کد ملی</label>
                                <input class="form-control" asp-for="PatientNationalId">
                            </div>
                            
                            <div class="col-12 col-md-6 mb-2">
                                <label class="form-label">تاریخ نوبت</label>
                                <input asp-for="ReservationDate" class="js-flatpickr form-control" data-enable-time="false" id="example-flatpickr-datetime" type="text" />
                            </div>

                            <div class="col-12 col-md-6 mb-2">
                                <label class="form-label">وضعیت نوبت</label>
                                <select asp-items="@Html.GetEnumSelectList<FilterRecordState>()" class="form-select" asp-for="State"></select>
                            </div>

                            <div class="col-12 col-md-6 mb-2">
                                <label class="form-label">نحوه پرداخت هزینه</label>
                                <select asp-items="@Html.GetEnumSelectList<FilterPaymentMethod>()" class="form-select" asp-for="PaymentMethod"></select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <p class="mb-1">تعداد نوبت ها بر اساس جستجو : @Model.Data.Count()</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal" type="button">بستن</button>
                        <button class="btn btn-sm btn-success" type="submit">جستجو</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal حذف گروهی -->
@if (Model.Data.Any())
{
    @foreach (var record in Model.Data)
    {
        <div aria-hidden="true" aria-labelledby="modal-default-normal" class="modal" id="modal-default-normal-@record.Id" role="dialog" tabindex="-1">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">حذف</h5>
                        <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
                    </div>
                    <div class="modal-body pb-1">
                        <p>آیا از حذف نوبت @record.Patient.FullName مطمئن هستید ؟</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-sm btn-alt-secondary" data-bs-dismiss="modal" type="button">لغو</button>
                        <a asp-controller="Record" asp-action="DeleteRecord" asp-route-id="@record.Id"
                           class="btn btn-sm btn-danger" type="submit">حذف</a>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section HeaderSection
{
    <!-- Page JS Plugins CSS -->
    <link href="/template/js/plugins/flatpickr/flatpickr.min.css" rel="stylesheet">
}

@section FooterSection
{
    <!-- Page JS Plugins -->
    <script src="/template/js/plugins/flatpickr/flatpickr.min.js"></script>
    <script>Dashmix.helpersOnLoad(['js-flatpickr']);</script>
}

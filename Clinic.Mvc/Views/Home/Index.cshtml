@using Clinic.Application.Utilities
@model Clinic.Application.DTOs.ReserveRecords.FilterRecordsDto

<div class="content">

    <div class="pt-4 px-4 bg-body-dark rounded push">
        <div class="row items-push justify-content-center">
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Record" asp-action="FilterRecord" class="block block-rounded block-link-pop text-center d-flex align-items-center h-100 mb-0">
                    <div class="block-content">
                        <p class="mb-2 d-none d-sm-block text-primary">
                            <i class="far fa-address-card opacity-50 fa-2x"></i>
                        </p>
                        <p class="fw-semibold fs-sm text-uppercase"> نوبت ها </p>
                    </div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Reservation" asp-action="SearchDays" class="block block-rounded block-link-pop text-center d-flex align-items-center h-100 mb-0">
                    <div class="block-content">
                        <p class="mb-2 d-none d-sm-block text-primary">
                            <i class="far fa-calendar-days opacity-50 fa-2x"></i>
                        </p>
                        <p class="fw-semibold fs-sm text-uppercase">نوبت دهی </p>
                    </div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Patient" asp-action="SearchPatient" class="block block-rounded block-link-pop text-center d-flex align-items-center h-100 mb-0">
                    <div class="block-content">
                        <p class="mb-2 d-none d-sm-block text-primary">
                            <i class="fa fa-users opacity-50 fa-2x"></i>
                        </p>
                        <p class="fw-semibold fs-sm text-uppercase"> بیماران </p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="block block-rounded">
        <div class="block-header block-header-default">
            <h3 class="block-title">بیماران امروز</h3>
            <div class="block-options">
                <a class="btn btn-sm btn-primary" asp-controller="Record" asp-action="FilterRecord" asp-route-date="@DateTime.Now.ToShamsiUrlFormat()">
                    لیست تمام نوبت های امروز
                </a>
            </div>
        </div>
        <div class="block-content block-content-full">
            <div class="table-responsive">
                @if (Model.Data.Any())
                {
                    var index = 1;
                    <table class="table table-striped table-bordered table-vcenter mb-0">
                        <thead>
                            <tr class="table-dark">
                                <th style="">#</th>
                                <th>نام بیمار</th>
                                <th>شماره تماس</th>
                                <th>ساعت نوبت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                           @foreach (var item in Model.Data.OrderBy(d => d.Reservation.ReserveDate))
                           {
                               <tr>
                                   <td>
                                       <span>@index )</span>
                                   </td>
                                   <td>
                                       <a class="fw-semibold" asp-controller="Record" asp-action="RecordDetail"
                                          asp-route-id="@item.Id">@item.Patient.FullName</a>
                                   </td>
                                   <td>
                                       <span>@item.Patient.Mobile</span>
                                   </td>
                                   
                                   <td>
                                       <span>@item.Reservation.ReserveDate.ToString("HH:mm")</span>
                                   </td>

                                   <td>
                                       <a class="btn btn-sm btn-alt-secondary" asp-controller="Patient" asp-action="PatientDetail"
                                          asp-route-id="@item.PatientId">
                                           <i class="fa fa-heartbeat text-danger me-1"></i> تاریخچه پزشکی
                                       </a>
                                   </td>
                               </tr>

                                index++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        <p class="mb-0">بیماری برای امروز وجود ندارد.</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

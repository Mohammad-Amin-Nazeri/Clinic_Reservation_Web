@model Clinic.Application.DTOs.Users.AuthenticationDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl" lang="fa" class="remember-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>احراز هویت</title>
    <meta name="description" content="Dashmix - قالب ادمین بوت استرپ 5 &amp; فریمورک رابط کاربری ساخته شده توسط pixelcave ">
    <meta name="author" content="pixelcave">
    <meta name="robots" content="index, follow">
    <link rel="shortcut icon" href="/template/media/favicons/favicon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/template/media/favicons/favicon-192x192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/template/media/favicons/apple-touch-icon-180x180.png">
    <link href="/template/css/dashmix.min.css" id="css-main" rel="stylesheet">
    <link href="/template/css/custom-fonts.css" rel="stylesheet" />
    <link href="/template/css/custom.css" rel="stylesheet" />
    <script src="/template/js/setTheme.js"></script>
    <link href="/template/js/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet">
</head>

<body>
    <div id="page-container">
        <!-- Main Container -->
        <main id="main-container">
            <!-- Page Content -->
            <div class="bg-image" style="background-image: url('/template/media/photos/photo22@2x.jpg');">
                <div class="row g-0 bg-primary-op">
                    <!-- Main Section -->
                    <div class="hero-static col-md-6 d-flex align-items-center justify-content-center bg-body-extra-light">
                        <div class="p-3 col-md-8 col-xl-6">
                            <!-- Header -->
                            <div class="mb-3 text-center">
                                <a class="link-fx fw-bold fs-1" href="/l">
                                    <span class="text-dark">Clinic</span><span class="text-primary">Reservation</span>
                                </a>
                                <p class="text-uppercase fw-bold fs-sm text-muted">احراز هویت</p>
                                <p class="text-muted fs-sm">
                                    لطفاً با وارد کردن کد مجوز ارسال شده به تلفن همراه خود حساب خود را تأیید کنید
                                    شماره <span dir="ltr">@Model.Mobile</span>.
                                </p>
                            </div>

                            <form asp-area="" asp-controller="Account" asp-action="Authentication" class="text-center" method="post">
                                <input type="hidden" asp-for="Mobile" />
                                <div style="direction: ltr" class="d-flex items-center justify-content-center gap-2 mb-4">
                                    <input asp-for="num1" class="form-control form-control-alt form-control-lg text-center px-0" id="num1" maxlength="1">
                                    <input asp-for="num2" class="form-control form-control-alt form-control-lg text-center px-0" id="num2" maxlength="1">
                                    <input asp-for="num3" class="form-control form-control-alt form-control-lg text-center px-0" id="num3" maxlength="1">
                                    <input asp-for="num4" class="form-control form-control-alt form-control-lg text-center px-0" id="num4" maxlength="1">
                                    <input asp-for="num5" class="form-control form-control-alt form-control-lg text-center px-0" id="num5" maxlength="1">
                                </div>
                                <div class="mb-4">
                                    <button class="btn btn-lg btn-hero btn-primary" type="submit">
                                        <i class="fa fa-fw fa-lock-open opacity-50 me-1"></i> ثبت
                                    </button>
                                </div>

                                <div class="otp-resend">
                                    <span id="timer">2:00</span>
                                    <button id="resendBtn" disabled>ارسال مجدد</button>
                                </div>
                            </form>
                            <!-- END Two Factor Form -->
                        </div>
                    </div>
                    <div class="hero-static col-md-6 d-none d-md-flex align-items-md-center justify-content-md-center text-md-center">
                        <div class="p-3">
                            <p class="display-4 fw-bold text-white mb-3">
                                به آینده خوش آمدید
                            </p>
                            <p class="fs-lg fw-semibold text-white-75 mb-0">
                                کپی‌رایت &copy; <span data-toggle="year-copy"></span>
                            </p>
                        </div>
                    </div>
                    <!-- END Meta Info Section -->
                </div>
            </div>
            <!-- END Page Content -->
        </main>
        <!-- END Main Container -->
    </div>

    <script src="/template/js/dashmix.app.min.js"></script>
    <script src="/template/js/pages/op_auth_two_factor.min.js"></script>
    <script src="/template/js/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="/template/js/custom.js"></script>
    <script src="/template/js/otpresend.js"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    title: "پیغام موفقیت",
                    text: '@TempData["SuccessMessage"]',
                    icon: "success",
                    width: '28em',
                    confirmButtonText: "باشه"
                });
            });
        </script>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    title: "پیغام هشدار",
                    text: '@TempData["WarningMessage"]',
                    icon: "warning",
                    width: '28em',
                    confirmButtonText: "باشه"
                });
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    icon: "error",
                    width: '28em',
                    title: "خطایی رخ داده",
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonText: "باشه"
                });
            });
        </script>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                Swal.fire({
                    icon: "info",
                    title: "اطلاعیه",
                    width: '28em',
                    text: '@TempData["InfoMessage"]',
                    confirmButtonText: "باشه"
                });
            });
        </script>
    }
</body>
</html>
